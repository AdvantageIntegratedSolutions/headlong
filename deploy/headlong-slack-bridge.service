# headlong-slack-bridge systemd unit. Installed by deploy/setup.sh (when
# SHELLM_INSTALL_SLACK_BRIDGE=1), which substitutes @SHELLM_HOME@.
#
# deploy/update.sh re-syncs this file on every deploy — put box-local
# changes in a drop-in (headlong-slack-bridge.service.d/override.conf).
#
# Socket Mode: the bridge dials OUT to Slack over a websocket; nothing
# listens. It talks to headlong-web on 127.0.0.1:8080 and tails the persona
# identity's trajectory file directly.
#
# Privilege separation, the same shape as headlong-telegram-bridge:
#  - User=shellm-slack (NOT shellm): the agent runs as shellm and can
#    read /proc/<pid>/environ of same-uid processes, so running the bridge
#    as shellm would hand it the bot and app tokens. Moving the tokens to
#    a separate file protects the file, not the process.
#  - The tokens live in /etc/shellm/slack.env, root-owned mode 600;
#    systemd reads it as root before dropping privileges
#    (deploy/split-bridge-env.sh moves them there from the root .env).
#  - StateDirectory (cursor + active threads) is owned by shellm-slack, so
#    an injected agent cannot rewrite which threads the bridge follows.
#  - SupplementaryGroups=shellm grants read access to the identity's
#    trajectory under /opt/shellm (group r-x on the home dir). Read only:
#    the bridge cannot append delivery notices, and says so once in its log
#    (slack/src/headlong_slack/outbound.py), as the Telegram bridge does.
#
# ExecStart uses the project venv directly (not tools/headlong-slack-bridge):
# uv would try to write the shellm-owned venv, which this user cannot.

[Unit]
Description=headlong Slack Socket Mode bridge
After=network-online.target headlong-web.service headlong-slack-agent.service
Wants=network-online.target

[Service]
Type=simple
User=shellm-slack
SupplementaryGroups=shellm
WorkingDirectory=@SHELLM_HOME@/app
# '-' prefix: missing .env (first boot, before the SSM fetch lands) must not
# fail the unit — the bridge exits and Restart=always retries until it works.
# Non-secret settings (SHELLM_SLACK_IDENTITY, SLACK_THREAD_FOLLOWUPS, ...)
# stay in the root .env.
EnvironmentFile=-@SHELLM_HOME@/app/.env
# Later files win, so a token still in .env is overridden here.
EnvironmentFile=-/etc/shellm/slack.env
StateDirectory=shellm-slack
Environment="HOME=/var/lib/shellm-slack"
Environment="HEADLONG_SLACK_STATE_DIR=/var/lib/shellm-slack"
ExecStart=@SHELLM_HOME@/app/slack/.venv/bin/headlong-slack-bridge @SHELLM_HOME@/app
Restart=always
RestartSec=5
# Default KillMode is fine: the bridge spawns no agent processes.

# Kill switch: `systemctl stop headlong-slack-bridge` mutes Slack without
# touching the agent (tools/headlong-killall stops the agent itself).

[Install]
WantedBy=multi-user.target
